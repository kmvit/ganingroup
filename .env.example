# Переменные окружения сайта. На сервере скопировать в .env и заполнить.
# Файл .env в git не попадает.

# Обязательно своё случайное значение (сгенерировать:
# python -c "import secrets;print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=a318f7177847.vps.myjino.ru,localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=https://a318f7177847.vps.myjino.ru

# Почта для уведомлений о заявках (получатели настраиваются в админке).
# Если EMAIL_HOST пуст — письма пишутся в лог контейнера.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=site@ganin-group.ru
